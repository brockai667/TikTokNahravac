<?xml version="1.0" encoding="utf-8"?>
<!--
  Sluzba dostupnosti je v systeme VYPNUTA, kym ju pouzivatel sam nezapne
  (Nastavenia -> Dostupnost -> TikTok Nahravac). Nic neklika, iba cita strom
  obrazovky TikToku, ked o to aplikacia poziada (kalibracia).
  packageNames zamerne nie je zadane: aktivne okno sa zistuje cez rootInActiveWindow
  a kod ignoruje vsetko, co nie je TikTok.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="200" />
