<?xml version="1.0" encoding="utf-8"?>
<!--
  Sluzba dostupnosti je v systeme VYPNUTA, kym ju pouzivatel sam nezapne
  (Nastavenia -> Dostupnost -> TikTok Nahravac). Sama nic nerobi: klikanie v TikToku
  nahrava a prehrava LEN vtedy, ked to pouzivatel spusti v aplikacii ("Naucit postup",
  "Nahrat automaticky"). Udalosti z klavesnice, systemu a launcheru sa ignoruju.
  packageNames zamerne nie je zadane: v kode sa vyberaju okna TikToku podla nazvu balika
  (TikTok ma viac variantov: musically, trill, musically.go).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewClicked|typeViewTextChanged|typeViewSelected|typeViewScrolled|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="100" />
