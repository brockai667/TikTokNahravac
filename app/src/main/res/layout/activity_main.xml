<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Hlavička: balík TikToku (dlhé podržanie = skrytý výpis stromu obrazovky) -->
        <TextView
            android:id="@+id/tvTikTok"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Stav služby dostupnosti (dlhé podržanie = zdieľať posledný výpis) -->
        <TextView
            android:id="@+id/tvA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

        <!-- Jedno tlačidlo: stiahne nové diely všetkých kanálov a uverejní ich -->
        <Button
            android:id="@+id/btnRunAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="72dp"
            android:text="@string/btn_run_all"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvAutoHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_hint"
            android:textColor="@color/status_gray"
            android:textSize="13sp" />

        <!-- Čo sa naposledy stiahlo a ako to vidí galéria (skryté, kým nič nie je stiahnuté) -->
        <TextView
            android:id="@+id/tvLastDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/status_gray"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnOpenGallery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_gallery"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnA11ySettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_a11y_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auto_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cb_confirm" />

        <TextView
            android:id="@+id/tvMacro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShowMacro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_show_macro" />

            <Button
                android:id="@+id/btnClearMacro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_clear_macro" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_refresh" />

        <!-- Sem sa kódom vkladajú kanály a epizódy -->
        <LinearLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />
    </LinearLayout>
</ScrollView>
